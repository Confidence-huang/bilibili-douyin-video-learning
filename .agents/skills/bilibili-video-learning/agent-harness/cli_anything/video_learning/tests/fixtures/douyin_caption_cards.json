 },
 "segments": [
  {
   "start": 0.0,
   "end": 2.35,
   "text": "中国男性是天底下最好的血包"
  },
  {
   "start": 2.5,
   "end": 3.85,
   "text": "中国男性出生就好像是为了"
  },
  {
   "start": 4.0,
   "end": 4.6,
   "text": "被人压榨"
  },
  {
   "start": 4.5,
   "end": 5.1,
   "text": "被人剥削"
  },
  {
   "start": 5.0,
   "end": 5.85,
   "text": "被人吸血"
  },
  {
   "start": 6.0,
   "end": 7.35,
   "text": "被人吃干抹净再丢掉的"
  },
  {
   "start": 7.5,
   "end": 8.1,
   "text": "作为一个血包"
  },
  {
   "start": 8.0,
   "end": 9.85,
   "text": "他已经被设计的近乎完美了。"
  },
  {
   "start": 10.0,
   "end": 11.35,
   "text": "昨天晚上11点钟我还在工作"
  },
  {
   "start": 11.5,
   "end": 12.35,
   "text": "顺便在跟我妈聊天"
  },
  {
   "start": 12.5,
   "end": 13.85,
   "text": "我妈就跟我说让我早点休息"
  },
  {
   "start": 14.0,
   "end": 14.85,
   "text": "多注意注意身体"
  },
  {
   "start": 15.0,
   "end": 16.35,
   "text": "听到这我还是挺欣慰的"
  },
  {
   "start": 16.5,
   "end": 17.85,
   "text": "可后面我妈又紧接着跟我说"
  },
  {
   "start": 18.0,
   "end": 18.85,
   "text": "只有有个好身体"
  },
  {
   "start": 19.0,
   "end": 19.85,
   "text": "才能照顾好整个家庭"
  },
  {
   "start": 20.0,
   "end": 20.85,
   "text": "将来才有精力"
  },
  {
   "start": 21.0,
   "end": 21.85,
   "text": "赚钱、买房、买车"
  },
  {
   "start": 22.5,
   "end": 23.1,
   "text": "结婚、娶老婆、生孩子"
  },
  {
   "start": 23.0,
   "end": 23.6,
   "text": "只有身体健康"
  },
  {
   "start": 23.5,
   "end": 24.85,
   "text": "你才能做出更大的事业"
  },
  {
   "start": 25.0,
   "end": 25.85,
   "text": "赚更多的钱"
  },
  {
   "start": 26.0,
   "end": 26.6,
   "text": "我们家里"
  },
  {
   "start": 26.5,
   "end": 27.1,
   "text": "我们村里"
  },
  {
   "start": 27.0,
   "end": 27.85,
   "text": "就你最有出息了"
  },
  {
   "start": 28.0,
   "end": 28.85,
   "text": "能留在大城市"
  },
  {
   "start": 29.0,
   "end": 29.85,
   "text": "等你以后还要帮衬他们"
  },
  {
   "start": 30.0,
   "end": 30.85,
   "text": "拉他们一把"
  },
  {
   "start": 31.0,
   "end": 32.35,
   "text": "那个时候我们都会以你为荣的"
  },
  {
   "start": 32.5,
   "end": 33.35,
   "text": "接着我忽然又意识到"
  },
  {
   "start": 33.5,
   "end": 35.35,
   "text": "这些话好像是我从小听到大的"
  },
  {
   "start": 35.5,
   "end": 36.85,
   "text": "那一刻我好像突然开悟了"
  },
  {
   "start": 37.0,
   "end": 38.85,
   "text": "然后我就觉得我的胃有点隐隐作痛"
  },
  {
   "start": 39.0,
   "end": 39.85,
   "text": "那种痛苦又开始由我的胃"
  },
  {
   "start": 40.0,
   "end": 41.85,
   "text": "蔓延到我全身的每一个神经末梢"
  },
  {
   "start": 42.0,
   "end": 42.85,
   "text": "当时我就在想"
  },
  {
   "start": 43.0,
   "end": 43.85,
   "text": "原来我从小到大的努力"
  },
  {
   "start": 44.0,
   "end": 45.35,
   "text": "就是为了变成一个"
  },
  {
   "start": 45.35,
   "end": 45.95,
   "text": "更高级"
  },
  {
   "start": 45.5,
   "end": 46.1,
   "text": "更耐用"
  },
  {
   "start": 46.0,
   "end": 47.35,
   "text": "更能持续供血的血包吗"
  },
  {
   "start": 47.5,
   "end": 48.85,
   "text": "我拼命的去提升自己"
  },
  {
   "start": 49.0,
   "end": 49.6,
   "text": "去考大学"
  },
  {
   "start": 49.5,
   "end": 50.35,
   "text": "去大城市闯荡"
  },
  {
   "start": 50.5,
   "end": 51.35,
   "text": "去工作去创业"
  },
  {
   "start": 51.5,
   "end": 52.1,
   "text": "就是为了"
  },
  {
   "start": 52.0,
   "end": 53.35,
   "text": "买房子、买车、结婚、生孩子"
  },
  {
   "start": 53.5,
   "end": 54.1,
   "text": "赡养家人"
  },
  {
   "start": 54.0,
   "end": 54.6,
   "text": "帮衬亲戚吗？"
  },
  {
   "start": 54.5,
   "end": 55.85,
   "text": "这就是我活着的价值吗？"
  },
  {
   "start": 56.0,
   "end": 56.85,
   "text": "我甚至开始反思"
  },
  {
   "start": 57.0,
   "end": 58.85,
   "text": "人活着难道不是为了自己吗？"
  },
  {
   "start": 59.0,
   "end": 59.85,
   "text": "难道不是为了过上自己想要的生活"
  },
  {
   "start": 60.5,
   "end": 61.35,
   "text": "做自己喜欢的事情吗？"
  },
  {
   "start": 61.5,
   "end": 62.85,
   "text": "为什么会有一种生物"
  },
  {
   "start": 63.0,
   "end": 64.85,
   "text": "它存在的价值是给别人创造价值呢？"
  },
  {
   "start": 65.0,
   "end": 66.35,
   "text": "那和猪圈里养肥了再杀的猪"
  },
  {
   "start": 66.5,
   "end": 67.35,
   "text": "又有什么区别呢？"
  },
  {
   "start": 67.5,
   "end": 68.35,
   "text": "我又想到了我爸"
  },
  {
   "start": 68.5,
   "end": 69.85,
   "text": "6年前他死于一场脑溢血"
  },
  {
   "start": 70.0,
   "end": 70.85,
   "text": "这也是因为他一直在"
  },
  {
   "start": 71.0,
   "end": 71.6,
   "text": "高强度的"
  },
  {
   "start": 71.5,
   "end": 72.35,
   "text": "工作、加班、应酬"
  },
  {
   "start": 72.5,
   "end": 73.35,
   "text": "埋下了病根"
  },
  {
   "start": 73.5,
   "end": 74.35,
   "text": "从他发病的那天起"
  },
  {
   "start": 74.5,
   "end": 76.35,
   "text": "医院就已经给他下病危通知书了。"
  },
  {
   "start": 76.5,
   "end": 77.35,
   "text": "因为发现的太晚了"
  },
  {
   "start": 77.5,
   "end": 78.35,
   "text": "人已经没有意识了"
  },
  {
   "start": 78.5,
   "end": 79.85,
   "text": "医生也明确说明他没救了。"
  },
  {
   "start": 80.0,
   "end": 81.35,
   "text": "但从他发病到死亡"
  },
  {
   "start": 81.5,
   "end": 82.35,
   "text": "中间间隔了3个月。"
  },
  {
   "start": 82.5,
   "end": 83.85,
   "text": "就是因为我们家明确要求医生"
  },
  {
   "start": 84.0,
   "end": 85.35,
   "text": "给他用药和器械续命"
  },
  {
   "start": 85.5,
   "end": 86.85,
   "text": "让他硬生生的续了三个月。"
  },
  {
   "start": 87.0,
   "end": 87.85,
   "text": "为什么要这样做呢？"
  },
  {
   "start": 88.0,
   "end": 89.35,
   "text": "因为那个时候我刚好快高考了"
  },
  {
   "start": 89.5,
   "end": 90.35,
   "text": "家里为了不影响我考试"
  },
  {
   "start": 90.5,
   "end": 91.35,
   "text": "就对我隐瞒了。"
  },
  {
   "start": 91.5,
   "end": 92.35,
   "text": "所以在那三个月里"
  },
  {
   "start": 92.5,
   "end": 93.85,
   "text": "他们都跟我说我爸出差去了。"
  },
  {
   "start": 94.0,
   "end": 95.85,
   "text": "直到我高考最后一场考试结束以后"
  },
  {
   "start": 96.0,
   "end": 97.35,
   "text": "在我走出考场的那一刻"
  },
  {
   "start": 97.5,
   "end": 98.35,
   "text": "我才知道真相。"
  },
  {
   "start": 98.5,
   "end": 99.35,
   "text": "然后我就到医院看到了我爸"
  },
  {
   "start": 99.5,
   "end": 101.35,
   "text": "他本来是一个200多斤的大胖子。"
  },
  {
   "start": 101.5,
   "end": 102.1,
   "text": "当我看到他的时候"
  },
  {
   "start": 102.0,
   "end": 103.35,
   "text": "他已经瘦的没有人样了"
  },
  {
   "start": 103.5,
   "end": 104.35,
   "text": "只有100多斤"
  },
  {
   "start": 104.5,
   "end": 105.35,
   "text": "眼球变得黄黄的"
  },
  {
   "start": 106.0,
   "end": 106.6,
   "text": "还有一层白膜。"
  },
  {
   "start": 106.5,
   "end": 107.85,
   "text": "身上的皮肤已经干燥开裂了"
  },
  {
   "start": 108.0,
   "end": 108.85,
   "text": "浑身都是淤青"
  },
  {
   "start": 109.0,
   "end": 109.85,
   "text": "再加上他已经没有"
  },
  {
   "start": 110.0,
   "end": 110.85,
   "text": "主动进食和排泄的能力了"
  },
  {
   "start": 111.0,
   "end": 112.85,
   "text": "所以他身上插满了十几根管子。"
  },
  {
   "start": 113.0,
   "end": 113.6,
   "text": "有食道管"
  },
  {
   "start": 113.5,
   "end": 114.1,
   "text": "有尿管"
  },
  {
   "start": 114.0,
   "end": 114.85,
   "text": "有药管。"
  },
  {
   "start": 115.0,
   "end": 115.6,
   "text": "那种感觉就好像"
  },
  {
   "start": 115.5,
   "end": 116.35,
   "text": "一个人被抽干了一样"
  },
  {
   "start": 116.5,
   "end": 117.85,
   "text": "只剩下一具干瘪的皮囊"
  },
  {
   "start": 118.0,
   "end": 119.85,
   "text": "当时算上我在内的十几个亲戚"
  },
  {
   "start": 120.0,
   "end": 120.85,
   "text": "都围在那张病床旁边"
  },
  {
   "start": 121.0,
   "end": 121.85,
   "text": "大家都在哭"
  },
  {
   "start": 122.0,
   "end": 122.85,
   "text": "都在说我爸狠心"
  },
  {
   "start": 123.0,
   "end": 124.85,
   "text": "就这么把我们娘俩丢在世上遭罪了"
  },
  {
   "start": 125.0,
   "end": 125.85,
   "text": "自己享福去了。"
  },
  {
   "start": 126.0,
   "end": 126.85,
   "text": "但只有我在旁边看着他"
  },
  {
   "start": 127.0,
   "end": 128.35,
   "text": "我觉得他现在如果有意识的话"
  },
  {
   "start": 128.5,
   "end": 129.35,
   "text": "那一定很痛苦"
  },
  {
   "start": 129.5,
   "end": 130.85,
   "text": "他一定不喜欢现在的自己。"
  },
  {
   "start": 131.0,
   "end": 132.85,
   "text": "他就那么衣不蔽体的躺在病床上"
  },
  {
   "start": 133.0,
   "end": 133.85,
   "text": "而且他没有意识"
  },
  {
   "start": 134.0,
   "end": 134.6,
   "text": "没有隐私"
  },
  {
   "start": 134.5,
   "end": 135.1,
   "text": "没有尊严"
  },
  {
   "start": 135.0,
   "end": 136.35,
   "text": "他甚至连体面的离开这个世界"
  },
  {
   "start": 136.5,
   "end": 137.1,
   "text": "都做不到"
  },
  {
   "start": 137.0,
   "end": 138.85,
   "text": "就为了能让自己的孩子安心备考"
  },
  {
   "start": 139.0,
   "end": 140.35,
   "text": "他连自己的肉体都控制不了。"
  },
  {
   "start": 140.5,
   "end": 141.85,
   "text": "从那一刻我也开始意识到"
  },
  {
   "start": 142.0,
   "end": 142.85,
   "text": "男人天生就是血包"
  },
  {
   "start": 143.0,
   "end": 144.35,
   "text": "我爸直到他断气的那一刻"
  },
  {
   "start": 144.5,
   "end": 145.85,
   "text": "都在履行他作为一个血包的责任。"
  },
  {
   "start": 146.0,
   "end": 147.85,
   "text": "我爸去世的那一年他是45岁"
  },
  {
   "start": 148.0,
   "end": 149.35,
   "text": "再过20年我就跟我爸一样大了。"
  },
  {
   "start": 149.5,
   "end": 150.35,
   "text": "可是我感觉我现在跟那具尸体"
  },
  {
   "start": 151.0,
   "end": 152.35,
   "text": "并没有什么本质的区别"
  },
  {
   "start": 152.5,
   "end": 153.1,
   "text": "虽然我还年轻"
  },
  {
   "start": 153.0,
   "end": 153.6,
   "text": "还健康"
  },
  {
   "start": 153.5,
   "end": 154.35,
   "text": "还有意识"
  },
  {
   "start": 154.5,
   "end": 155.1,
   "text": "可我的时间"
  },
  {
   "start": 155.0,
   "end": 155.6,
   "text": "我的精力"
  },
  {
   "start": 155.5,
   "end": 156.1,
   "text": "我的身体"
  },
  {
   "start": 156.0,
   "end": 157.35,
   "text": "甚至我未来的几十年"
  },
  {
   "start": 157.5,
   "end": 158.35,
   "text": "好像早就被一套"
  },
  {
   "start": 158.5,
   "end": 159.35,
   "text": "默认的流程安排好了"
  },
  {
   "start": 159.5,
   "end": 160.85,
   "text": "他告诉我要努力工作"
  },
  {
   "start": 161.0,
   "end": 161.6,
   "text": "因为我要赚钱"
  },
  {
   "start": 161.5,
   "end": 163.35,
   "text": "我要赚钱是因为我要买房买车"
  },
  {
   "start": 163.5,
   "end": 164.85,
   "text": "我买房买车是因为我要结婚"
  },
  {
   "start": 165.0,
   "end": 166.35,
   "text": "我要结婚是因为我要生孩子"
  },
  {
   "start": 166.5,
   "end": 167.85,
   "text": "有了孩子以后我更要努力工作"
  },
  {
   "start": 168.0,
   "end": 169.35,
   "text": "因为我要给他更好的教育"
  },
  {
   "start": 169.5,
   "end": 170.35,
   "text": "家人老了我要赡养"
  },
  {
   "start": 170.5,
   "end": 171.85,
   "text": "亲戚有困难我要帮衬"
  },
  {
   "start": 172.0,
   "end": 173.35,
   "text": "事业做起来还要帮助身边的人"
  },
  {
   "start": 173.5,
   "end": 174.35,
   "text": "我必须源源不断的"
  },
  {
   "start": 174.5,
   "end": 175.35,
   "text": "给身边的人创造价值"
  },
  {
   "start": 175.5,
   "end": 176.35,
   "text": "成为别人的养分"
  },
  {
   "start": 176.5,
   "end": 177.85,
   "text": "否则我就不像个男人。"
  },
  {
   "start": 178.0,
   "end": 179.35,
   "text": "这个社会对于好男人的定义"
  },
  {
   "start": 179.5,
   "end": 180.85,
   "text": "也无非就是长得高长得帅"
  },
  {
   "start": 181.0,
   "end": 181.6,
   "text": "性格温柔"
  },
  {
   "start": 181.5,
   "end": 182.85,
   "text": "还有钱、有房、有车、有存款"
  },
  {
   "start": 183.0,
   "end": 184.35,
   "text": "还舍得给别人花钱。"
  },
  {
   "start": 184.5,
   "end": 185.85,
   "text": "你会发现成为一个好男人的标准"
  },
  {
   "start": 186.0,
   "end": 187.35,
   "text": "居然是能否给别人带来价值"
  },
  {
   "start": 187.5,
   "end": 189.35,
   "text": "不管是情绪价值还是经济价值"
  },
  {
   "start": 189.5,
   "end": 191.35,
   "text": "如果一个男性不能提供这些价值"
  },
  {
   "start": 191.5,
   "end": 192.35,
   "text": "如果他长相普通"
  },
  {
   "start": 192.5,
   "end": 193.1,
   "text": "身高一般"
  },
  {
   "start": 193.0,
   "end": 193.85,
   "text": "家境差自己还没钱"
  },
  {
   "start": 194.0,
   "end": 195.35,
   "text": "那他在别人眼里就是一个下头男"
  },
  {
   "start": 195.5,
   "end": 196.35,
   "text": "就是一个loser"
  },
  {
   "start": 196.5,
   "end": 197.35,
   "text": "哪怕别人对他的生活"
  },
  {
   "start": 197.5,
   "end": 198.85,
   "text": "对他的过往一无所知"
  },
  {
   "start": 199.0,
   "end": 199.85,
   "text": "大家还是会这么想。"
  },
  {
   "start": 200.0,
   "end": 201.35,
   "text": "甚至哪怕是一个所谓成功的男性"
  },
  {
   "start": 201.5,
   "end": 202.85,
   "text": "但有一天他突然累了"
  },
  {
   "start": 203.0,
   "end": 203.6,
   "text": "穷了"
  },
  {
   "start": 203.25,
   "end": 203.85,
   "text": "病了"
  },
  {
   "start": 203.5,
   "end": 204.35,
   "text": "失去价值了"
  },
  {
   "start": 204.5,
   "end": 206.35,
   "text": "那他的评价也会很差很差"
  },
  {
   "start": 206.5,
   "end": 207.35,
   "text": "他也会过得非常凄惨。"
  },
  {
   "start": 207.5,
   "end": 209.35,
   "text": "包括最近去世了很多知名的男性"
  },
  {
   "start": 209.5,
   "end": 210.35,
   "text": "但大家谈论的都是"
  },
  {
   "start": 210.5,
   "end": 211.35,
   "text": "这个男性去世以后"
  },
  {
   "start": 211.5,
   "end": 212.35,
   "text": "他的家人怎么办"
  },
  {
   "start": 212.5,
   "end": 213.35,
   "text": "他的父母孩子怎么办"
  },
  {
   "start": 213.5,
   "end": 215.35,
   "text": "他们会说他的父母家人好可怜"
  },
  {
   "start": 215.5,
   "end": 216.35,
   "text": "他的粉丝好可怜"
  },
  {
   "start": 216.5,
   "end": 217.85,
   "text": "他们再也得不到他的照顾了。"
  },
  {
   "start": 218.0,
   "end": 219.35,
   "text": "我们再也看不到他的作品了。"
  },
  {
   "start": 219.5,
   "end": 221.35,
   "text": "但没有人在意他生前过得开不开心"
  },
  {
   "start": 221.5,
   "end": 222.1,
   "text": "累不累"
  },
  {
   "start": 222.0,
   "end": 223.35,
   "text": "有没有过上自己想要的生活"
  },
  {
   "start": 223.5,
   "end": 224.35,
   "text": "更没有人在意他的感受。"
  },
  {
   "start": 224.5,
   "end": 226.35,
   "text": "大家关心的永远都是他死了"
  },
  {
   "start": 226.5,
   "end": 227.85,
   "text": "他不能继续创造价值了"
  },
  {
   "start": 228.0,
   "end": 228.85,
   "text": "好可惜啊"
  },
  {
   "start": 229.0,
   "end": 229.85,
   "text": "就好像大家在感慨"
  },
  {
   "start": 230.0,
   "end": 230.85,
   "text": "一台坏掉的机器一样。"
  },
  {
   "start": 231.0,
   "end": 232.85,
   "text": "而且没有人觉得有什么不对"
  },
  {
   "start": 233.0,
   "end": 234.35,
   "text": "可怜这些站在聚光灯下的名人"
  },
  {
   "start": 234.5,
   "end": 235.35,
   "text": "都要落得这个下场。"
  },
  {
   "start": 235.5,
   "end": 236.85,
   "text": "那那些普通男性的一生"
  },
  {
   "start": 237.0,
   "end": 237.85,
   "text": "又会过得怎么样呢？"
  },
  {
   "start": 238.0,
   "end": 238.6,
   "text": "今天说了这么多"
  },
  {
   "start": 238.5,
   "end": 239.85,
   "text": "其实我就想说一句话"
  },
  {
   "start": 240.0,
   "end": 241.35,
   "text": "我觉得男性当然可以有责任感"
  },
  {
   "start": 241.5,
   "end": 242.1,
   "text": "可以努力赚钱"
  },
  {
   "start": 242.0,
   "end": 242.85,
   "text": "可以照顾父母"
  },
  {
   "start": 243.0,
   "end": 243.85,
   "text": "伴侣和孩子。"
  },
  {
   "start": 244.0,
   "end": 244.85,
   "text": "但我觉得你至少要记住"
  },
  {
   "start": 245.0,
   "end": 245.85,
   "text": "你不是谁的工具"
  },
  {
   "start": 246.0,
   "end": 247.35,
   "text": "也不要做谁的血包。"
  },
  {
   "start": 247.5,
   "end": 248.1,
   "text": "你有资格累"
  },
  {
   "start": 248.0,
   "end": 248.6,
   "text": "有资格休息"
  },
  {
   "start": 248.5,
   "end": 249.35,
   "text": "有资格拒绝"
  },
  {
   "start": 249.5,
   "end": 250.85,
   "text": "有资格过自己喜欢的生活"
  },
  {
   "start": 251.0,
   "end": 251.85,
   "text": "有资格不那么成功"
  },
  {
   "start": 252.0,
   "end": 253.35,
   "text": "你更有资格把钱和时间"
  },
  {
   "start": 253.5,
   "end": 254.35,
   "text": "花在自己身上。"
  },
  {
   "start": 254.5,
   "end": 255.35,
   "text": "你当然可以成为一个"
  },
  {
   "start": 255.5,
   "end": 256.85,
   "text": "好儿子、好丈夫、好父亲"
  },
  {
   "start": 257.0,
   "end": 257.85,
   "text": "但在这些身份之前"
  },
  {
   "start": 258.0,
   "end": 259.35,
   "text": "你首先得是你自己。"
  }
 ]
}