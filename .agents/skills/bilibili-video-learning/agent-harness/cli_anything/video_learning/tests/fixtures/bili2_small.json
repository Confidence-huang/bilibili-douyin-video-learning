{"coverage_before": 0.9236, "coverage_after": 0.9236, "device": "cuda", "segments": [{"start": 0.0, "end": 0.76, "text": "在一次奧運會上", "confidence": -0.185, "provenance": "asr"}, {"start": 0.76, "end": 1.84, "text": "這個叫米格爾的運動員", "confidence": -0.185, "provenance": "asr"}, {"start": 1.84, "end": 2.76, "text": "得於太緊張", "confidence": -0.185, "provenance": "asr"}, {"start": 2.76, "end": 3.64, "text": "她號稱還沒吹響", "confidence": -0.185, "provenance": "asr"}, {"start": 3.64, "end": 4.68, "text": "她就因為失去平衡", "confidence": -0.185, "provenance": "asr"}, {"start": 4.68, "end": 5.8, "text": "直接摔進了水裡", "confidence": -0.185, "provenance": "asr"}, {"start": 5.8, "end": 7.76, "text": "想到還沒機會真正展現自己的力量", "confidence": -0.185, "provenance": "asr"}, {"start": 7.76, "end": 8.64, "text": "就以失敗告容", "confidence": -0.185, "provenance": "asr"}, {"start": 8.64, "end": 9.68, "text": "米格爾徹底崩潰", "confidence": -0.185, "provenance": "asr"}, {"start": 9.68, "end": 11.2, "text": "她的奧運夢似乎完全過滅了", "confidence": -0.185, "provenance": "asr"}, {"start": 11.2, "end": 11.8, "text": "平序失控", "confidence": -0.185, "provenance": "asr"}, {"start": 11.8, "end": 13.32, "text": "她內流滿面的離開了幾條台", "confidence": -0.185, "provenance": "asr"}, {"start": 13.32, "end": 14.72, "text": "但令人驚嘆的事情發生了", "confidence": -0.185, "provenance": "asr"}, {"start": 14.72, "end": 15.96, "text": "如果有其他選手都同意", "confidence": -0.185, "provenance": "asr"}, {"start": 15.96, "end": 17.12, "text": "不得給她第二次機會", "confidence": -0.185, "provenance": "asr"}, {"start": 17.12, "end": 18.44, "text": "否則他們不會開始比賽", "confidence": -0.185, "provenance": "asr"}, {"start": 18.44, "end": 20.44, "text": "目睹了這種令人難以置信的體育精神後", "confidence": -0.185, "provenance": "asr"}, {"start": 20.44, "end": 21.2, "text": "還算允許了", "confidence": -0.185, "provenance": "asr"}, {"start": 21.2, "end": 22.64, "text": "當米格爾再次站上起跑線", "confidence": -0.185, "provenance": "asr"}, {"start": 22.64, "end": 24.64, "text": "当他重新回到起跑线全场废头", "confidence": -0.371, "provenance": "asr"}, {"start": 24.64, "end": 25.56, "text": "每个人都在看着他", "confidence": -0.371, "provenance": "asr"}, {"start": 25.56, "end": 26.64, "text": "这是他就属的时刻", "confidence": -0.371, "provenance": "asr"}, {"start": 26.64, "end": 27.32, "text": "相声响起", "confidence": -0.371, "provenance": "asr"}, {"start": 27.32, "end": 28.4, "text": "米哥尔终身一跃", "confidence": -0.371, "provenance": "asr"}, {"start": 28.4, "end": 29.56, "text": "攻进权力向前楼", "confidence": -0.371, "provenance": "asr"}, {"start": 29.56, "end": 30.84, "text": "攻防追赶的前辈的选手", "confidence": -0.371, "provenance": "asr"}, {"start": 30.84, "end": 32.88, "text": "最后他以最后一名的成绩结束比赛", "confidence": -0.371, "provenance": "asr"}, {"start": 33.28, "end": 44.21, "text": "还痛哭流涕像的啊", "confidence": -0.371, "provenance": "asr"}, {"start": 44.21, "end": 49.91, "text": "差点就让你胡弄过去了", "confidence": -0.371, "provenance": "asr"}, {"start": 49.91, "end": 52.75, "text": "米哥尔巧识妥悄记", "confidence": -0.371, "provenance": "asr"}, {"start": 52.75, "end": 55.39, "text": "正好和默契寨边秀王", "confidence": -0.371, "provenance": "asr"}, {"start": 55.39, "end": 59.67, "text": "以前跳进水里的时候", "confidence": -0.371, "provenance": "asr"}, {"start": 59.67, "end": 61.71, "text": "我但是倒数第二", "confidence": -0.371, "provenance": "asr"}, {"start": 61.71, "end": 63.67, "text": "差点就极数", "confidence": -0.371, "provenance": "asr"}, {"start": 63.67, "end": 66.27, "text": "哎呀哈哈哈哈", "confidence": -0.371, "provenance": "asr"}, {"start": 66.27, "end": 68.03, "text": "你不用那我也不用了", "confidence": -0.707, "provenance": "asr"}, {"start": 68.03, "end": 77.45, "text": "而不行", "confidence": -0.707, "provenance": "asr"}, {"start": 78.33, "end": 79.33, "text": "彩盘万一", "confidence": -0.707, "provenance": "asr"}, {"start": 79.33, "end": 80.33, "text": "要取消你成绩", "confidence": -0.707, "provenance": "asr"}, {"start": 80.33, "end": 81.73, "text": "我们都有把下洋", "confidence": -0.707, "provenance": "asr"}, {"start": 81.73, "end": 86.26, "text": "不朋友人给几回吗", "confidence": -0.707, "provenance": "asr"}, {"start": 86.26, "end": 90.04, "text": "你违绝不到别人的时候", "confidence": -0.707, "provenance": "asr"}, {"start": 90.04, "end": 93.08, "text": "会发现世界上全都是好人", "confidence": -0.707, "provenance": "asr"}, {"start": 94.32, "end": 96.12, "text": "这下大家都开心了", "confidence": -0.707, "provenance": "asr"}, {"start": 97.48, "end": 98.76, "text": "命生也有了", "confidence": -0.707, "provenance": "asr"}, {"start": 99.44, "end": 100.84, "text": "命救也有了", "confidence": -0.707, "provenance": "asr"}, {"start": 101.6, "end": 102.36, "text": "美女", "confidence": -0.707, "provenance": "asr"}, {"start": 103.16, "end": 106.68, "text": "这把有些我不开眼吧", "confidence": -0.707, "provenance": "asr"}, {"start": 108.88, "end": 110.88, "text": "字幕by索兰娅", "confidence": -0.593, "provenance": "asr"}]}